# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never exposed to the browser. Used for admin actions
# (e.g. force-logout, bulk import) that need to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
